profiles {
  isca {
    params.base               = '/lustre/projects/Research_Project-MRC147594'
    params.software           = "${params.base}/software"
    params.rsync              = "${params.software}/rsync"
    params.sambamba           = "${params.software}/sambamba/sambamba-1.0.1-linux-amd64-static"
    params.picardJar          = "${params.software}/picard3/picard.jar"
    params.gatkJar            = "${params.software}/gatk4/gatk-4.6.1.0/gatk-package-4.6.1.0-local.jar"
    params.referenceFasta     = "${params.base}/resources/grch38-v2-pipeline/Homo_sapiens_assembly38.fasta"
    params.referenceGFF       = "${params.base}/resources/grch38-v2-pipeline/gencode.v47.chr_patch_hapl_scaff.annotation.gff3"
    params.exomeDepthReference= "${params.base}/resources/exome_depth_reference3/"
    params.tmpDir             = "${params.base}/genome_sequencing/NF_temp/"
    params.goldStandardIndels = "${params.base}/resources/grch38-v2-pipeline/Mills_and_1000G_gold_standard.indels.hg38.vcf"
    params.dbSnp              = "${params.base}/resources/grch38-v2-pipeline/Homo_sapiens_assembly38.dbsnp138.vcf"
    params.easyRegions        = "${params.base}/resources/grch38-v2-pipeline/Heng_Li_2025_PMC12409275_GRCh38_easy_regions.bed"
    params.resourcesDir       = "${params.base}/resources/grch38-v2-pipeline"
    params.gnomadCommon       = "${params.base}/resources/grch38-v2-pipeline/gnomad_v4_1_popmax001.bcf"
    params.gnomadSNP          = "${params.base}/resources/grch38-v2-pipeline/gnomad_v4_1_popmax01.bcf"
    params.gnomadSNPFilter   = "${params.base}/resources/grch38-v2-pipeline/gnomad_v4_1_common.object"
    params.hla_regions        = "${params.base}/resources/grch38-v2-pipeline/hla_master_regions.bed"
    params.chr6_fasta         = "${params.base}/resources/grch38-v2-pipeline/GRCh38_chr6.fasta"
    params.xtea_libraries     = "${params.base}/resources/grch38-v2-pipeline/xTEA/"
    params.vepData            = "${params.base}/resources/grch38-v2-pipeline/vep_data/"
    params.xy_bitmap          = "${params.base}/resources/grch38-v2-pipeline/current_r04.bitmap"
    params.cytomegaloFasta    = "${params.base}/resources/grch38-v2-pipeline/cytomegalovirus/cytomegalovirus.fasta"
    params.javaDir            = "${params.software}/in-house/software/java"
    params.rtgtools           = "${params.software}/rtg-tools/rtg-tools-3.12.1/rtg"
    params.expHunterDeNovo    = "${params.software}/expansionhunter-denovo/ExpansionHunterDenovo-v0.9.0-linux_x86_64/bin/ExpansionHunterDenovo"
    params.auxSoftware        = "${params.software}/in-house/software/exome_pipeline"
    params.fastdup            = "${params.software}/fastdup/bin/fastdup"
    params.alamut             = "${params.software}/alamut/alamut-batch-standalone-1.11/alamut-batch"
    params.bwaMem3            = "${params.software}/bwa-mem3/bin/bwa-mem3"
    params.bwaMem2            = "${params.software}/bwa-mem2/bwa-mem2-2.3_x64-linux/bwa-mem2"
    params.bwaMem1            = "${params.software}/bwa-mem/bwa-0.7.19/bwa"
    params.bwaMem1RefDir      = "${params.resourcesDir}/bwa-mem1"
    params.mantaChromBed      = "${params.resourcesDir}/manta_chrom.bed.gz"
    params.survindel2model      = "${params.resourcesDir}/survindel2_model/ml-model"
    // force fq input
    params.forcefq             = false
    params.rerun_all           = false
    params.skip_parliament     = true
    params.skip_manta          = false
    params.skip_xTEA           = true
    params.align_only          = false
    // Email notifications
    params.send_mail = true
    // SLURM specific settings
    params.pbsQueueing        = true
    process.executor = 'slurm'
    process.errorStrategy = { sleep(Math.pow(2, task.attempt) * 200 as long); return 'retry' }
    process.maxRetries   = 5
    process.queue = 'mrcq'
    executor.account = 'Research_Project-MRC147594'
    executor.queueSize = 50
    apptainer {
      enabled = true
      cacheDir = "/lustre/projects/Research_Project-MRC147594/genome_sequencing/Genome_Pipeline_Containers/"
      pullTimeout = '240m'
      autoMounts = true
      envWhitelist = ['APPTAINER_TMPDIR', 'TMPDIR']
    }
    env {
      APPTAINER_TMPDIR = "/lustre/projects/Research_Project-MRC147594/genome_sequencing/NF_temp/"
      TMPDIR = "/lustre/projects/Research_Project-MRC147594/genome_sequencing/NF_temp/"
    }
    cleanup = true
  }

  ennis {
    params.base               = '/ennis/projects/Research_Project-MRC147594'
    params.software           = "${params.base}/software"
    params.tmpDir             = '/scratch'
    params.picardJar          = "${params.software}/picard/picard-2-7-1.jar"
    params.gatkJar            = "${params.software}/gatk/GenomeAnalysisTK-nightly-2016-12-05-ga159770/GenomeAnalysisTK.jar"
    params.referenceFasta     = "${params.base}/resources/grch38-v2-pipeline/human_g1k_v37.fasta"
    params.exomeDepthReference= "${params.base}/resources/exome_depth_reference3/"
    params.goldStandardIndels = "${params.base}/resources/grch38-v2-pipeline/Mills_and_1000G_gold_standard.indels.b37.vcf"
    params.dbSnp              = "${params.base}/resources/grch37/dbsnp_141.b37.vcf"
    params.resourcesDir       = "${params.base}/resources/resources3/"
    params.gnomadCommon       = "${params.base}/resources/grch37/gnomad_common.object"
    params.gnomadAll          = "${params.base}/resources/grch37/gnomad_all.object"
    params.javaDir            = "${params.software}/in-house/software/java"
    params.auxSoftware        = "${params.software}/in-house/software/exome_pipeline"
    params.alamut             = "${params.software}/alamut/alamut-batch-standalone-1.11/alamut-batch"
    params.bwa                = "${params.software}/bwa/bwa-0.7.15/bwa"
    params.rScript            = "${params.software}/R/R-3.0.2/bin/Rscript"
    params.kevlarMask         = "${params.base}/resources/kevlar/b37_mask.ct"
    params.pbsQueueing        = false
  }
}
/* plugins {
  id 'nf-boost'
}

boost {
  cleanup = 'v2'
  cleanupInterval = '300s'
} */

process.beforeScript = { 
    def cmd = """
        umask 0002
       """.stripIndent().trim()
    return cmd
   }


process.afterScript = {

    def logMainDir = params.batchDir + "/r04_logs"
    logMainDir = workflow.launchDir.resolve(logMainDir).toString()

    def safeProc = task.process
                    .replaceAll(/\s+/, '_')
                    .replaceAll(/[()]/, '')

    def logDir = "${logMainDir}/${safeProc}"

    // Sanitise tag for use in filenames
    def safeTag = task.tag?.toString()
                    ?.replaceAll(/[^a-zA-Z0-9_.-]/, '_')
    def tagPrefix = safeTag ? "${safeTag}_" : ''

    def cmd = """
        # Make new files and directories group-writable
        umask 0002

        # Logging errors must not fail the task
        set +e

        # Record directory contents
        ls -alR --full-time > .command.ls 2>/dev/null || true

        # Create local log directory
        mkdir -p nxf_log

        # Collect command logs without preserving metadata
        for f in .command.*; do
            [ -f "\${f}" ] || continue

            dest="nxf_log/${tagPrefix}\${f#.}.txt"

            cp "\${f}" "\${dest}" || \\
                echo "WARNING: Could not copy \${f}" >&2

            chmod 664 "\${dest}" 2>/dev/null || true
        done

        # Create central logging directory
        if mkdir -p "${logDir}"; then

            # Group writable, setgid so files inherit directory group
            chmod 2775 "${logDir}" 2>/dev/null || true

            # Remove old logs for this sample only
            if [ -n "${tagPrefix}" ]; then
                rm -f "${logDir}/${tagPrefix}command."*.txt 2>/dev/null || true
            fi

            # Copy new logs
            for f in nxf_log/*; do
                [ -f "\${f}" ] || continue

                cp "\${f}" "${logDir}/" || \\
                    echo "WARNING: Could not archive \${f}" >&2

                dest="${logDir}/\${f##*/}"
                chmod 664 "\${dest}" 2>/dev/null || true
            done

        else
            echo "WARNING: Could not create ${logDir}" >&2
        fi

        # Logging always completes successfully
        true

    """.stripIndent().trim()

    return cmd
}

